.DS_Store

# .claude — track team-shared config (agents, skills, hooks), ignore runtime/personal
.claude/projects/
.claude/cache/
.claude/conversations/
.claude/local/
.claude/settings.local.json
.claude/*.local.json
.claude/scheduled_tasks.lock

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
/.worktrees/

# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
**/.idea/
**/*.iml

# Per-user Flutter DevTools enablement state (extensions: ... toggles).
# Regenerated locally; not a project default.
devtools_options.yaml

# leonard_cli trajectory output (local run artifacts, not source).
packages/leonard_cli/trajectories/

# Astro product site build artifacts (belt-and-braces with site/.gitignore).
site/node_modules/
site/dist/
site/.astro/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
lenny-whn/

# .beads/ exclusions are owned by bd's own .beads/.gitignore (kept current with
# `bd doctor`). Do NOT blanket-ignore `.beads/*` with negations here: bd warns
# that negation patterns override the fork protection in .git/info/exclude, and
# the blanket silently hides files bd expects tracked (config.yaml carries
# sync.remote, so a fresh clone can't bootstrap without it).
#
# Two per-machine files bd's template doesn't cover yet:
#   hooks.log    — local hook output
#   routes.jsonl — prefix->filesystem-path routing table; absolute-ish paths
#                  valid only on this machine (same reason bd ignores `redirect`)
.beads/hooks.log
.beads/routes.jsonl
.beads/formulas/

# the_grid live-arm scratch (the station cuts per-bead worktrees here when THIS
# checkout is the substation root: .grid/worktrees/<substation>/<bead>, and each
# driven bead drops its critique/, discovery/, telemetry/ and pr-body.md here).
# Never tracked — throwaway per-run working state, not source.
.grid/

# Gas City factory committee — DERIVED artifacts composed by
# scripts/install-rig-committee.sh (the neutral factoryskills pack + the
# .gascity-pack Dart overlay). Source of truth is .gascity-pack/ (tracked); the
# composed copies are reproducible, so they are not committed. lenny's own
# agents (lenny-pilot, lenny-driver) and skills (beads, debug-inference,
# harden, predictable-flutter) stay tracked — canonical source in .agents/
# (the cross-client convention), symlinked into .claude/ for Claude Code.
# Ignore only the factory-composed agents, not lenny's own.
.agents/agents/architect.md
.agents/agents/bitsmith.md
.agents/agents/critique.md
.claude/agents/architect.md
.claude/agents/bitsmith.md
.claude/agents/critique.md
.agents/skills/critique/
.agents/skills/deliberate/
.agents/skills/discover/
.agents/skills/factory/
.agents/skills/factoryskills/
.agents/skills/forge/
.agents/skills/land/
.agents/skills/marshal/
.agents/skills/merge/
.agents/skills/route/
.agents/skills/specify/
.claude/skills/critique/
.claude/skills/deliberate/
.claude/skills/discover/
.claude/skills/factory/
.claude/skills/factoryskills/
.claude/skills/forge/
.claude/skills/land/
.claude/skills/marshal/
.claude/skills/merge/
.claude/skills/route/
.claude/skills/specify/

# Local scratch / factory runtime state — not part of the repo
spikes/
.gc/
.factoryskills/sessions.jsonl

# Env files — never commit secrets
*.env
.env
